# Salin file ini menjadi .env dan isi dengan kredensial project Supabase Anda.
# Kredensial ini didapat dari Supabase Dashboard -> Project Settings -> API.
#
# VITE_SUPABASE_ANON_KEY adalah kunci PUBLIK (anon/public key) — aman
# ditaruh di sisi klien karena akses sesungguhnya dikontrol oleh Row Level
# Security (RLS) & fungsi SECURITY DEFINER di supabase/schema.sql, BUKAN
# oleh kerahasiaan kunci ini. JANGAN PERNAH menaruh Supabase "service_role"
# key di sini atau di kode frontend mana pun (SECURITY.md §7.4).

VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here
